# Postgres. Local dev uses the docker-compose service in this repo.
DATABASE_URL="postgresql://dayemon:dayemon@127.0.0.1:5432/dayemon?schema=public"

# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL="info"

